<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <IsBindingProject>true</IsBindingProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>SyntaxCircus.Maui.StoreKit</PackageId>
    <Title>SyntaxCircus MAUI StoreKit</Title>
    <Description>iOS-only StoreKit 2 native binding for MAUI apps: implements SyntaxCircus.Maui.Environments' IAppTransactionEnvironmentProvider via a small native Swift shim, since Apple's AppTransaction API is Swift-only and isn't bound by dotnet/macios directly. Lets IosDistributionChannelService detect TestFlight vs. App Store vs. Xcode-run installs.</Description>
    <Authors>Syntax Circus LLC</Authors>
    <Company>Syntax Circus LLC</Company>
    <Copyright>Copyright © Syntax Circus LLC</Copyright>
    <PackageTags>maui;ios;storekit;apptransaction</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Syntax-Circus/SyntaxCircus.Maui.StoreKit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Syntax-Circus/SyntaxCircus.Maui.StoreKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SyntaxCircus.Maui.Environments" />
    <PackageReference Include="GitVersion.MsBuild" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinitions.cs" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Must be the .xcframework, not a RuntimeIdentifier-conditioned bare .a per slice: this is a
      *library* project, and RuntimeIdentifier does not propagate down from a consuming app's
      ProjectReference into a referenced library's own build - a condition on $(RuntimeIdentifier)
      here would only ever be evaluated against this project's own (usually RID-less) build, never
      the app's, so it silently never matches and the NativeReference item never gets added at
      all. An .xcframework's whole purpose is to be RID-agnostic at this level - the correct slice
      is selected by the *app's* build only at final link time.
    -->
    <NativeReference Include="..\..\native\AppTransactionBridge\build\AppTransactionBridge.xcframework">
      <Kind>Static</Kind>
      <SmartLink>true</SmartLink>
    </NativeReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
